# Axion Stream Backend & Supabase Configuration
# Configure these values in the AI Studio Secrets panel.
# NEVER put Telegram bot tokens, API IDs, API hashes, session strings, or private channel credentials here.
# All Telegram media resolution MUST stay strictly on the secure backend server.

# Base URL of the authorized Axion Stream backend API (e.g., https://api.yourdomain.com)
AXION_API_BASE_URL=https://api.axion-stream.example.com

# Supabase project URL for user & movie metadata integration
SUPABASE_URL=https://your-project.supabase.co

# Supabase public anon key (Row-Level Security protected)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
