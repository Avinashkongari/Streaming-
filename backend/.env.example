# =============================================================================
# AXION STREAM BACKEND — SERVER-SIDE ENVIRONMENT VARIABLES
# Copy to .env for local development or configure in your cloud host secrets.
# NEVER commit .env or expose ANY of these values to the Android client app.
# =============================================================================

# Server
PORT=8080
NODE_ENV=production
# Comma-separated list of allowed browser origins for your separate Admin Panel (Android native app does not need wildcard CORS)
CORS_ALLOWED_ORIGINS=https://admin.yourdomain.com
# Optional public HTTPS URL of this deployed server (used only for metadata/logging)
PUBLIC_BASE_URL=

# Supabase (Server-side Service Role Key — NEVER expose to clients)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Session & Code Hashing Pepper (generate with: openssl rand -hex 32)
TOKEN_PEPPER=

# Session lifetimes (hours)
USER_SESSION_TTL_HOURS=720
ADMIN_SESSION_TTL_HOURS=12

# Dedicated Admin Authentication (generate hash with: npm run hash-password)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=

# Telegram MTProto Private Channel Integration (Server-side ONLY)
# Obtain API_ID and API_HASH from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generate once locally via: npm run telegram-session
TELEGRAM_SESSION_STRING=
# Private channel numeric ID (e.g. -1001234567890)
TELEGRAM_CHANNEL_ID=

# Streaming limits
MAX_VIDEO_SIZE_BYTES=230686720
STREAM_CHUNK_SIZE_BYTES=524288
